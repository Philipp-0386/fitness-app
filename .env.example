# Copy to .env and fill in. Used by the root compose.yaml for all services.

# Database
POSTGRES_DB=x
POSTGRES_USER=y
POSTGRES_PASSWORD=z

# Backend
JWT_SECRET=at-least-64-bytes-for-HS512
API_DOCS_ENABLED=false # for  Swagger UI and /v3/api-docs

# Spring profile. Defaults to "dev" in compose.yaml, which adds the Flyway location holding the test users.
SPRING_PROFILES_ACTIVE=dev

# Prod only: bcrypt hashes for the two seeded accounts (admin, max). Required by compose.prod.yaml.
# Single quotes are mandatory, otherwise compose interpolates the $ signs of the hash.
SEED_ADMIN_PASSWORD_HASH='$2a$10$...'
SEED_USER_PASSWORD_HASH='$2a$10$...'

# Host ports (optional, defaults shown)
POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=3000
