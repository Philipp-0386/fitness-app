### Routines
#
# Requires the REST Client extension (humao.rest-client).
# Send one of the logins in section 1 first, every request below reads its token
# from that named response.
#
# Preconditions:
#   docker compose --profile full up -d
#   test users seeded by the dev Flyway location (SPRING_PROFILES_ACTIVE=dev)
#
# Seeded routines (ids assume a fresh database):
#   1 Push, 2 Pull, 3 Legs   presets (user_id NULL, slug set), V2 reference data
#   4 Push A                 max
#   5 Legs                   lena_lifts
#   6 Pull                   max, copy of preset 'pull'
#   7 Push, 8 Pull, 9 Legs   max, copies from taking the preset program
#   marco and sina own no routines.

@host = http://localhost:8080
@frontend = http://localhost:3000

###############################################################################
###############################################################################
# 1  Logins
###############################################################################
###############################################################################

### 1.1  Log in as max
# @name loginMax
POST {{host}}/backend/auth/login
Content-Type: application/json

{
  "username": "max",
  "password": "password"
}

### 1.2  Log in as lena_lifts
# @name loginLena
POST {{host}}/backend/auth/login
Content-Type: application/json

{
  "username": "lena_lifts",
  "password": "password"
}

### 1.3  Log in as sina (owns no routines)
# @name loginSina
POST {{host}}/backend/auth/login
Content-Type: application/json

{
  "username": "sina",
  "password": "password"
}

###############################################################################
###############################################################################
# 2  Preset routines
###############################################################################
###############################################################################

# Presets are the same for every user. They are templates only: workouts and
# programs cannot reference them, a user always works on an own copy.

### 2.1  List presets -> 200, 3 entries ordered by name: Legs, Pull, Push
GET {{host}}/backend/routines/presets
Authorization: Bearer {{loginMax.response.body.$.accessToken}}

### 2.2  Same list for another user -> identical body
GET {{host}}/backend/routines/presets
Authorization: Bearer {{loginLena.response.body.$.accessToken}}

### 2.3  A single preset -> 200 "Push" with its exercises
# Every entry carries "deleted": false, presets only reference global exercises.
GET {{host}}/backend/routines/presets/1
Authorization: Bearer {{loginMax.response.body.$.accessToken}}

### 2.4  The same preset for a user without own routines -> 200, identical body
# The preset detail view is not ownership scoped, every user can read it.
GET {{host}}/backend/routines/presets/1
Authorization: Bearer {{loginSina.response.body.$.accessToken}}

# The four requests below must return an identical body, just like section 5.

### 2.5  An own routine through the preset path -> 404 PRESET_ROUTINE_NOT_FOUND
# Id 4 exists and even belongs to max. The preset query filters on user_id IS NULL.
GET {{host}}/backend/routines/presets/4
Authorization: Bearer {{loginMax.response.body.$.accessToken}}

### 2.6  A copy of a preset -> 404 PRESET_ROUTINE_NOT_FOUND
# Id 6 is max's copy of 'pull', same name and description, but user_id is set
# and the slug is not. A copy is an own routine, not a preset.
GET {{host}}/backend/routines/presets/6
Authorization: Bearer {{loginMax.response.body.$.accessToken}}

### 2.7  Another user's routine through the preset path -> 404 PRESET_ROUTINE_NOT_FOUND
GET {{host}}/backend/routines/presets/5
Authorization: Bearer {{loginMax.response.body.$.accessToken}}

### 2.8  An id that was never seeded -> 404 PRESET_ROUTINE_NOT_FOUND
GET {{host}}/backend/routines/presets/999999
Authorization: Bearer {{loginMax.response.body.$.accessToken}}

###############################################################################
###############################################################################
# 3  Own routines are user-scoped
###############################################################################
###############################################################################

# Same endpoint, different token, different result. Presets never show up here.

### 3.1  max -> 200, 5 entries ordered by name: Legs, Pull, Pull, Push, Push A
GET {{host}}/backend/routines
Authorization: Bearer {{loginMax.response.body.$.accessToken}}

### 3.2  lena_lifts -> 200, 1 entry "Legs"
GET {{host}}/backend/routines
Authorization: Bearer {{loginLena.response.body.$.accessToken}}

### 3.3  sina -> 200 with an empty list, not 404
GET {{host}}/backend/routines
Authorization: Bearer {{loginSina.response.body.$.accessToken}}

###############################################################################
###############################################################################
# 4  Detail view of an own routine
###############################################################################
###############################################################################

### 4.1  max reads his own routine -> 200 "Push A" with 4 exercises
# Ordered by orderIndex 0-3: Barbell Bench Press, Seated Dumbbell Shoulder Press,
# Triceps Rope Pushdown, Plank. Plank only sets targetSets and
# targetDurationSeconds, its reps are null.
GET {{host}}/backend/routines/4
Authorization: Bearer {{loginMax.response.body.$.accessToken}}

### 4.2  lena_lifts reads her own routine -> 200 "Legs"
GET {{host}}/backend/routines/5
Authorization: Bearer {{loginLena.response.body.$.accessToken}}

###############################################################################
###############################################################################
# 5  The detail view is ownership scoped
###############################################################################
###############################################################################

# The three requests below must return an identical body. Any difference would
# tell a caller which ids exist behind routines they cannot read.

### 5.1  max asks for lena's routine -> 404 USER_ROUTINE_NOT_FOUND
# Deliberately not 403: a 403 would confirm that id 5 exists.
GET {{host}}/backend/routines/5
Authorization: Bearer {{loginMax.response.body.$.accessToken}}

### 5.2  A preset through the user path -> 404 USER_ROUTINE_NOT_FOUND
# Presets are only readable under /presets, so a preset can never be treated
# as an own, editable routine.
GET {{host}}/backend/routines/1
Authorization: Bearer {{loginMax.response.body.$.accessToken}}

### 5.3  An id that was never seeded -> 404 USER_ROUTINE_NOT_FOUND
GET {{host}}/backend/routines/999999
Authorization: Bearer {{loginMax.response.body.$.accessToken}}

###############################################################################
###############################################################################
# 6  Access control and malformed paths
###############################################################################
###############################################################################

### 6.1  No token on the list -> 401 UNAUTHENTICATED
GET {{host}}/backend/routines

### 6.2  No token on the presets -> 401 UNAUTHENTICATED
# Presets are public data, but the endpoint still sits behind the filter chain.
GET {{host}}/backend/routines/presets

### 6.3  Refresh token instead of an access token -> 401 UNAUTHENTICATED
GET {{host}}/backend/routines/4
Authorization: Bearer {{loginMax.response.body.$.refreshToken}}

### 6.4  Non-numeric id -> 400 INVALID_PARAMETER
GET {{host}}/backend/routines/abc
Authorization: Bearer {{loginMax.response.body.$.accessToken}}

### 6.5  Non-numeric preset id -> 400 INVALID_PARAMETER
GET {{host}}/backend/routines/presets/abc
Authorization: Bearer {{loginMax.response.body.$.accessToken}}

### 6.6  Trailing slash -> 404 RESOURCE_NOT_FOUND, not USER_ROUTINE_NOT_FOUND
GET {{host}}/backend/routines/4/
Authorization: Bearer {{loginMax.response.body.$.accessToken}}

### 6.7  No token on a single preset -> 401 UNAUTHENTICATED
GET {{host}}/backend/routines/presets/1

### 6.8  Refresh token on the presets -> 401 UNAUTHENTICATED
GET {{host}}/backend/routines/presets
Authorization: Bearer {{loginMax.response.body.$.refreshToken}}

### 6.9  Trailing slash on a preset -> 404 RESOURCE_NOT_FOUND, not PRESET_ROUTINE_NOT_FOUND
GET {{host}}/backend/routines/presets/1/
Authorization: Bearer {{loginMax.response.body.$.accessToken}}

###############################################################################
###############################################################################
# 7 Creating new routines
###############################################################################
###############################################################################

# Note: these requests write. Every send adds a routine, SO THE IDS BELOW MOVE!
# Exercise ids assume a fresh database: 1 Barbell Bench Press, 2 Incline Dumbbell
# (Press, 38 Plank (all global), 66 max, 67 lena_lifts, 68 marco, 69 sina (soft deleted))

### 7.1  Name only -> 201, "exercises": [], Location header on the new id
# A routine does not need exercises to be created.
POST {{host}}/backend/routines
Authorization: Bearer {{loginMax.response.body.$.accessToken}}
Content-Type: application/json

{
  "name": "Empty Routine"
}

### 7.2  With exercises -> 201, orderIndex taken from the list position
# Entry 0 is the incline press, entry 1 the bench press, entry 2 max's own
# exercise. The plank comes last with a duration target only.
# @name createRoutine
POST {{host}}/backend/routines
Authorization: Bearer {{loginMax.response.body.$.accessToken}}
Content-Type: application/json

{
  "name": "Upper Body REST Client",
  "description": "Created from the REST client.",
  "exercises": [
    { "exerciseId": 2, "targetSets": 3, "targetRepsMin": 8, "targetRepsMax": 10 },
    { "exerciseId": 1, "targetSets": 4, "targetRepsMin": 5, "targetRepsMax": 5 },
    { "exerciseId": 66, "targetSets": 2 },
    { "exerciseId": 38, "targetSets": 3, "targetDurationSeconds": 45 }
  ]
}

### 7.3  Read it back -> 200, same body as the create returned
GET {{host}}/backend/routines/{{createRoutine.response.body.$.id}}
Authorization: Bearer {{loginMax.response.body.$.accessToken}}

### 7.4  It belongs to max alone -> lena gets 404 USER_ROUTINE_NOT_FOUND
GET {{host}}/backend/routines/{{createRoutine.response.body.$.id}}
Authorization: Bearer {{loginLena.response.body.$.accessToken}}

### 7.5  The same exercise twice -> 201, two entries with their own targets
# Allowed on purpose, e.g. a heavy and a light block of the same movement.
POST {{host}}/backend/routines
Authorization: Bearer {{loginMax.response.body.$.accessToken}}
Content-Type: application/json

{
  "name": "Bench Twice",
  "exercises": [
    { "exerciseId": 1, "targetSets": 3, "targetRepsMin": 3, "targetRepsMax": 5 },
    { "exerciseId": 1, "targetSets": 2, "targetRepsMin": 12, "targetRepsMax": 15 }
  ]
}

###############################################################################
###############################################################################
# 8  Referenced exercises must be available to the caller
###############################################################################
###############################################################################

# The foreign key only proves that an exercise exists. The three requests below
# must return the same body apart from the id in the message, and none of them
# may leave a routine behind: check with 3.1 afterwards.

### 8.1  Another user's exercise -> 404 EXERCISE_NOT_FOUND
# Without this check, the detail view would leak the name of marco's exercise.
POST {{host}}/backend/routines
Authorization: Bearer {{loginMax.response.body.$.accessToken}}
Content-Type: application/json

{
  "name": "Borrowed Exercise",
  "exercises": [
    { "exerciseId": 1, "targetSets": 3 },
    { "exerciseId": 68, "targetSets": 3 }
  ]
}

### 8.2  An own but soft deleted exercise -> 404 EXERCISE_NOT_FOUND
# sina is the owner of 69, so this covers the deleted_at filter.
POST {{host}}/backend/routines
Authorization: Bearer {{loginSina.response.body.$.accessToken}}
Content-Type: application/json

{
  "name": "Deleted Exercise",
  "exercises": [
    { "exerciseId": 69, "targetSets": 3 }
  ]
}

### 8.3  An id that was never seeded -> 404 EXERCISE_NOT_FOUND, not 409 DATA_CONFLICT
# The service rejects it before the foreign key would.
POST {{host}}/backend/routines
Authorization: Bearer {{loginMax.response.body.$.accessToken}}
Content-Type: application/json

{
  "name": "Unknown Exercise",
  "exercises": [
    { "exerciseId": 999999, "targetSets": 3 }
  ]
}

###############################################################################
###############################################################################
# 9  Validation of the request body
###############################################################################
###############################################################################

# Each of these answers 400 VALIDATION_FAILED with fieldErrors. Entry fields are
# reported with their index, e.g. "exercises[0].targetSets".

### 9.1  No name -> 400 on "name"
POST {{host}}/backend/routines
Authorization: Bearer {{loginMax.response.body.$.accessToken}}
Content-Type: application/json

{
  "exercises": [
    { "exerciseId": 1, "targetSets": 3 }
  ]
}

### 9.2  An entry without exerciseId -> 400 on "exercises[0].exerciseId"
POST {{host}}/backend/routines
Authorization: Bearer {{loginMax.response.body.$.accessToken}}
Content-Type: application/json

{
  "name": "Missing Exercise Id",
  "exercises": [
    { "targetSets": 3 }
  ]
}

### 9.3  Reps range turned around -> 400 on "exercises[0].repRangeValid"
# Mirrors ck_routine_exercise_reps_range (caught before the database would)
POST {{host}}/backend/routines
Authorization: Bearer {{loginMax.response.body.$.accessToken}}
Content-Type: application/json

{
  "name": "Reversed Reps",
  "exercises": [
    { "exerciseId": 1, "targetRepsMin": 12, "targetRepsMax": 8 }
  ]
}

### 9.4  Targets out of range -> 400 on targetSets, targetRepsMin and targetDurationSeconds
POST {{host}}/backend/routines
Authorization: Bearer {{loginMax.response.body.$.accessToken}}
Content-Type: application/json

{
  "name": "Bad Targets",
  "exercises": [
    { "exerciseId": 1, "targetSets": 0, "targetRepsMin": 0 },
    { "exerciseId": 38, "targetDurationSeconds": -30 }
  ]
}

### 9.5  orderIndex in the body -> ignored, the list position wins
# Unknown properties are not rejected, so this answers 201 with orderIndex 0.
POST {{host}}/backend/routines
Authorization: Bearer {{loginMax.response.body.$.accessToken}}
Content-Type: application/json

{
  "name": "Forged Order",
  "exercises": [
    { "exerciseId": 1, "orderIndex": 7, "targetSets": 3 }
  ]
}

### 9.6  No token -> 401 UNAUTHENTICATED, body is never parsed
POST {{host}}/backend/routines
Content-Type: application/json

{
  "name": "Anonymous Routine"
}

###############################################################################
###############################################################################
# 10  Deleting own routines
###############################################################################
###############################################################################

# Note: these requests write. Every routine deleted here is created in 10.1
# first, the seeded routines stay untouched. Send 10.1 again to repeat a step.

### 10.1  Create a routine to delete -> 201
# @name deleteTarget
POST {{host}}/backend/routines
Authorization: Bearer {{loginMax.response.body.$.accessToken}}
Content-Type: application/json

{
  "name": "Delete Me Pls Thanks",
  "exercises": [
    { "exerciseId": 1, "targetSets": 3, "targetRepsMin": 8, "targetRepsMax": 10 },
    { "exerciseId": 38, "targetSets": 3, "targetDurationSeconds": 45 }
  ]
}

### 10.2  lena tries to delete it -> 404 USER_ROUTINE_NOT_FOUND
# Same body as 10.6 and 10.7, so lena cannot tell that the id exists.
DELETE {{host}}/backend/routines/{{deleteTarget.response.body.$.id}}
Authorization: Bearer {{loginLena.response.body.$.accessToken}}

### 10.3  It is still there for max -> 200 "Delete Me" with 2 exercises
GET {{host}}/backend/routines/{{deleteTarget.response.body.$.id}}
Authorization: Bearer {{loginMax.response.body.$.accessToken}}

### 10.4  max deletes it -> 204, empty body
# The routine_exercise rows go with it.
DELETE {{host}}/backend/routines/{{deleteTarget.response.body.$.id}}
Authorization: Bearer {{loginMax.response.body.$.accessToken}}

### 10.5  Read it back -> 404 USER_ROUTINE_NOT_FOUND
GET {{host}}/backend/routines/{{deleteTarget.response.body.$.id}}
Authorization: Bearer {{loginMax.response.body.$.accessToken}}

### 10.6  Delete it a second time -> 404 USER_ROUTINE_NOT_FOUND
DELETE {{host}}/backend/routines/{{deleteTarget.response.body.$.id}}
Authorization: Bearer {{loginMax.response.body.$.accessToken}}

### 10.7  A preset through the user path -> 404 USER_ROUTINE_NOT_FOUND
# Presets can never be deleted, check with 2.1 afterwards.
DELETE {{host}}/backend/routines/1
Authorization: Bearer {{loginMax.response.body.$.accessToken}}

### 10.8  No token -> 401 UNAUTHENTICATED
DELETE {{host}}/backend/routines/4

### 10.9  Refresh token instead of an access token -> 401 UNAUTHENTICATED
DELETE {{host}}/backend/routines/4
Authorization: Bearer {{loginMax.response.body.$.refreshToken}}

### 10.10  Non-numeric id -> 400 INVALID_PARAMETER
DELETE {{host}}/backend/routines/abc
Authorization: Bearer {{loginMax.response.body.$.accessToken}}

### 10.11  Without an id -> 405 METHOD_NOT_ALLOWED, the collection itself cannot be deleted
DELETE {{host}}/backend/routines
Authorization: Bearer {{loginMax.response.body.$.accessToken}}

###############################################################################
###############################################################################
# 11  To-Do/WIP
###############################################################################
###############################################################################

### 11.1  The list views do not include exercises
# Only the detail views do. A preview for the list (exercise names) is planned
# for the routine list UI.

### 11.2  Copying a preset